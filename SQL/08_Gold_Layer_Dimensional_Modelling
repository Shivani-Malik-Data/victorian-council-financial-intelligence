WITH all_fact_keys AS (
    SELECT 'fact_financial' AS TableName,
           Council, FinancialYear
    FROM workspace.default.fact_financial

    UNION ALL

    SELECT 'fact_financial_per_capita',
           Council, FinancialYear
    FROM workspace.default.fact_financial_per_capita

    UNION ALL

    SELECT 'fact_population',
           Council, FinancialYear
    FROM workspace.default.fact_population
)
SELECT
    f.TableName,
    COUNT(*) AS TotalRows,
    SUM(CASE WHEN c.CouncilName IS NULL
        THEN 1 ELSE 0 END) AS UnmatchedCouncils,
    SUM(CASE WHEN y.FinancialYear IS NULL
        THEN 1 ELSE 0 END) AS UnmatchedYears
FROM all_fact_keys f
LEFT JOIN workspace.default.dim_council c
    ON f.Council = c.CouncilName
LEFT JOIN workspace.default.dim_financial_year y
    ON f.FinancialYear = y.FinancialYear
GROUP BY f.TableName
ORDER BY f.TableName;




SELECT DISTINCT
    f.Council AS FactCouncil,
    c.CouncilName AS DimensionCouncil
FROM workspace.default.fact_financial f
LEFT JOIN workspace.default.dim_council c
    ON f.Council = c.CouncilName
WHERE c.CouncilName IS NULL
ORDER BY FactCouncil
LIMIT 30;


SELECT
    CouncilName,
    CouncilCategory
FROM workspace.default.dim_council
ORDER BY CouncilName
LIMIT 30;







WITH normalized_financial AS (
    SELECT
        Council,
        REGEXP_REPLACE(
            TRIM(Council),
            '(?i)\\s+Council$',
            ''
        ) AS NormalizedCouncil
    FROM workspace.default.fact_financial
)
SELECT
    COUNT(*) AS TotalRows,
    SUM(
        CASE WHEN c.CouncilName IS NULL
        THEN 1 ELSE 0 END
    ) AS UnmatchedAfterNormalization
FROM normalized_financial f
LEFT JOIN workspace.default.dim_council c
    ON f.NormalizedCouncil = c.CouncilName;





WITH combined AS (
    SELECT
        'fact_financial_per_capita' AS TableName,
        Council
    FROM workspace.default.fact_financial_per_capita

    UNION ALL

    SELECT
        'fact_population' AS TableName,
        Council
    FROM workspace.default.fact_population
),
normalized AS (
    SELECT
        TableName,
        REGEXP_REPLACE(
            TRIM(Council),
            '(?i)\\s+Council$',
            ''
        ) AS NormalizedCouncil
    FROM combined
)
SELECT
    n.TableName,
    COUNT(*) AS TotalRows,
    SUM(
        CASE WHEN c.CouncilName IS NULL
        THEN 1 ELSE 0 END
    ) AS UnmatchedCouncils
FROM normalized n
LEFT JOIN workspace.default.dim_council c
    ON n.NormalizedCouncil = c.CouncilName
GROUP BY n.TableName
ORDER BY n.TableName;








