    COUNT(*) AS DuplicateKeyGroups
FROM (
    SELECT Council, FinancialYear, IndicatorID
    FROM workspace.default.fact_performance
    GROUP BY Council, FinancialYear, IndicatorID
    HAVING COUNT(*) > 1
)

UNION ALL

