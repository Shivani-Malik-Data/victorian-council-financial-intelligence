FROM (
    SELECT Council, FinancialYear, Category, SubCategory
    FROM workspace.default.fact_financial
    GROUP BY Council, FinancialYear, Category, SubCategory
    HAVING COUNT(*) > 1
)

UNION ALL

SELECT
    'fact_financial_per_capita',
