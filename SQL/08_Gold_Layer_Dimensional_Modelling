FROM (
    SELECT Council, FinancialYear, Attribute
    FROM workspace.default.fact_financial_per_capita
    GROUP BY Council, FinancialYear, Attribute
    HAVING COUNT(*) > 1
)

UNION ALL

SELECT
    'fact_population',
