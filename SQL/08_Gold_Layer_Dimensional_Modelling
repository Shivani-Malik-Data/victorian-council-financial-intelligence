WITH all_fact_keys AS (
    SELECT 'fact_financial' AS TableName,
           Council, FinancialYear
    FROM workspace.default.fact_financial

    UNION ALL

    SELECT 'fact_financial_per_capita',
           Council, FinancialYear
    FROM workspace.default.fact_financial_per_capita

    UNION ALL

    SELECT 'fact_population',
           Council, FinancialYear
    FROM workspace.default.fact_population
)
SELECT
    f.TableName,
    COUNT(*) AS TotalRows,
    SUM(CASE WHEN c.CouncilName IS NULL
        THEN 1 ELSE 0 END) AS UnmatchedCouncils,
    SUM(CASE WHEN y.FinancialYear IS NULL
        THEN 1 ELSE 0 END) AS UnmatchedYears
FROM all_fact_keys f
LEFT JOIN workspace.default.dim_council c
    ON f.Council = c.CouncilName
LEFT JOIN workspace.default.dim_financial_year y
    ON f.FinancialYear = y.FinancialYear
GROUP BY f.TableName
ORDER BY f.TableName;





SELECT
    COUNT(*) AS TotalRows,
    COUNT(DISTINCT b.BenchmarkName) AS Benchmarks,
    COUNT(DISTINCT b.FinancialYear) AS Years,
    SUM(
        CASE WHEN y.FinancialYear IS NULL
        THEN 1 ELSE 0 END
    ) AS UnmatchedYears
FROM workspace.default.fact_financial_benchmarks b
LEFT JOIN workspace.default.dim_financial_year y
    ON b.FinancialYear = y.FinancialYear;




SELECT
    COUNT(*) AS TotalRows,
    SUM(
        CASE WHEN f.Council <> s.Council
        THEN 1 ELSE 0 END
    ) AS DifferentCouncilNames
FROM workspace.default.fact_population f
JOIN workspace.default.silver_population s
    ON f.FinancialYear = s.FinancialYear
   AND REGEXP_REPLACE(TRIM(f.Council), '(?i)\\s+Council$', '')
       = REGEXP_REPLACE(TRIM(s.Council), '(?i)\\s+Council$', '');





SELECT DISTINCT
    s.Council AS SilverCouncil,
    f.Council AS GoldCouncil
FROM workspace.default.silver_population s
JOIN workspace.default.fact_population f
    ON s.FinancialYear = f.FinancialYear
   AND REGEXP_REPLACE(
       TRIM(s.Council),
       '(?i)\\s+Council$',
       ''
   ) = REGEXP_REPLACE(
       TRIM(f.Council),
       '(?i)\\s+Council$',
       ''
   )
WHERE s.Council <> f.Council
ORDER BY SilverCouncil
LIMIT 20;





SELECT
    COUNT(*) AS TotalRows,
    SUM(
        CASE
            WHEN REGEXP_REPLACE(
                TRIM(s.Council),
                '(?i)\\s+Council$',
                ''
            ) = TRIM(f.Council)
            THEN 1 ELSE 0
        END
    ) AS MatchingNormalizedNames,
    SUM(
        CASE
            WHEN REGEXP_REPLACE(
                TRIM(s.Council),
                '(?i)\\s+Council$',
                ''
            ) <> TRIM(f.Council)
            THEN 1 ELSE 0
        END
    ) AS UnexpectedDifferences
FROM workspace.default.silver_population s
JOIN workspace.default.fact_population f
    ON s.FinancialYear = f.FinancialYear
   AND s.Population = f.Population
   AND REGEXP_REPLACE(
       TRIM(s.Council),
       '(?i)\\s+Council$',
       ''
   ) = TRIM(f.Council);






